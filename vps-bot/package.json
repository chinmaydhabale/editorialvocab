  "description": "Automated RSS feed reader and Google Blogger publisher for daily editorial vocabulary, idioms & interactive quizzes",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "once": "node src/index.js --once",
