# ==========================================
# EditorialVocab VPS Bot Configuration
# ==========================================

# 1. Gemini AI API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Preferred Gemini Model (e.g. gemini-3.6-flash, gemini-2.5-flash)
PREFERRED_MODEL=gemini-3.6-flash

# 3. Google Blogger API Settings
# Blog ID can be found in your Blogger dashboard URL (e.g. https://www.blogger.com/blog/posts/1234567890123456789 -> 1234567890123456789)
BLOGGER_BLOG_ID=your_blogger_blog_id_here

# 4. Google OAuth Credentials for 24/7 Unattended VPS Publishing
# Run `npm run get-token` to generate these credentials easily
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here

# 5. Automation Cron Schedule (Standard 5-field cron syntax)
# Set to run every hour (0 * * * *) so new editorials are published immediately upon RSS update
CRON_SCHEDULE=0 * * * *

# 6. Default Theme for Blogger HTML Post: warm | slate | cyber
BLOG_THEME=warm

# 7. Word Extraction Strategy: all | 10 | 15 | 20
WORD_COUNT=all

# 8. Google Search Console Instant Indexing API (Optional)
# Place your service_account.json file in vps-bot/ root or set path here
GOOGLE_SERVICE_ACCOUNT_KEY=service_account.json
